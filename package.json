{
  "name": "truffe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e": "playwright test",
    "dev:https": "vite --host --mode https",
    "balance": "vitest run tests/balance && node -e \"process.stdout.write(require('fs').readFileSync('test-results/equilibrage.txt','utf8'))\"",
    "perf": "playwright test --project=perf --workers=1",
    "build:app": "tsc --noEmit && vite build --mode app && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capgo/capacitor-updater": "^8.54.2",
    "idb": "^8.0.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
